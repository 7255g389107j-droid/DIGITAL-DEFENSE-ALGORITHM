run_itagaki_component_stability <- function(Dataset, tol = 1e-9) {
  
  # Initialize Logging
  timestamp <- format(Sys.time(), "%Y%m%d_%H%M%S")
  log_filename <- paste0("FORENSIC_COMPONENT_REPORT_", timestamp, ".txt")
  
  sink_file <- file(log_filename, open = "wt")
  sink(sink_file, split = TRUE) 
  on.exit({
    sink()
    close(sink_file)
  }, add = TRUE)
  
  # Basic Input Verification & Universal Matrix Conversion
  if (!exists("Dataset") || is.null(Dataset)) {
    stop("ERROR: Missing required input object (Dataset).")
  }
  
  if (is.list(Dataset) && !is.data.frame(Dataset)) {
    P_raw <- do.call(rbind, lapply(Dataset, as.numeric))
  } else {
    P_raw <- as.matrix(Dataset)
  }
  
  # Fetch layout coordinates
  component_names <- colnames(P_raw)
  if (is.null(component_names)) component_names <- paste0("C_", 1:ncol(P_raw))
  colnames(P_raw) <- component_names
  
  n_s <- nrow(P_raw)
  n_t <- ncol(P_raw)
  
  if (n_s < 3 || n_t < 1) {
    stop("ERROR: At least 3 samples (rows) are required to calculate meaningful column variance.")
  }
  
  cat("\n==========================================================\n")
  cat("    ITAGAKI PHYSICAL STABILITY ENGINE: COLUMN-WISE MAP    \n")
  cat("==========================================================\n")
  cat(sprintf("Total Input Samples (n_s)     : %d\n", n_s))
  cat(sprintf("Total Evaluated Elements (n_t): %d\n", n_t))
  cat("==========================================================\n\n")
  
  # --- 1. GENERALIZED DATA CLEANING (SAMPLE-WISE PRE-SCREENING) ---
  # Filter out entirely zero-fill sample vectors or negative anomalies
  valid_rows <- rowSums(abs(P_raw)) > tol
  if (sum(valid_rows) < 3) {
    stop("CRITICAL ERROR: Insufficient variance profile across active non-zero rows.")
  }
  P_clean <- P_raw[valid_rows, , drop = FALSE]
  n_s_clean <- nrow(P_clean)
  
  # Secure lower physical boundary to prevent log(0) calculation
  positive_values <- P_clean[P_clean > tol]
  global_min_positive <- if(length(positive_values) > 0) min(positive_values) else 1.0
  P_secure <- pmax(P_clean, global_min_positive)
  
  # Compute Component-Wise Effective Scaling Library Vector (Per Column Minima)
  col_minima <- apply(P_secure, 2, min)
  eff_lib_vec <- 1 / pmax(col_minima, tol)
  
  # Log-transform raw distribution values
  L_mat <- log(P_secure)
  
  # --- 2. COLUMN-WISE STABILITY EVALUATION (IR & Sp GENERATION) ---
  # Compute Observed Empirical Column Variance (V_obs) across samples (MARGIN = 2)
  obs_v_vec <- apply(L_mat, 2, var)
  
  # Compute Theoretical Stochastic Variance (V_theo) per column
  col_means <- colMeans(P_secure)
  theo_v_vec <- 1 / pmax(col_means * eff_lib_vec, tol)
  
  # Compute Column Invariance Ratio (IR) & Physical Deviation Score (Sp)
  ir_vec <- obs_v_vec / theo_v_vec
  sp_vec <- log10(ir_vec + 1)
  
  # --- 3. METRIC PIPELINE ORDERING ---
  stability_report <- data.frame(
    Component_ID          = component_names,
    Mean_Intensity        = round(col_means, 4),
    Observed_Variance     = round(obs_v_vec, 4),
    Theoretical_Variance  = round(theo_v_vec, 4),
    Invariance_Ratio_IR   = round(ir_vec, 4),
    Physical_Deviation_Sp = round(sp_vec, 6),
    stringsAsFactors      = FALSE
  )
  
  # Sort strictly by Component_ID to maintain original column mapping order
  stability_report <- stability_report[order(stability_report$Component_ID), ]
  
  # Print evaluation block
  print(stability_report, right = FALSE, row.names = FALSE)
  
  # --- 4. CONSOLE TELEMETRY TERMINATION SUMMARY ---
  cat("----------------------------------------------------------\n")
  cat("METRIC DEFINITIONS:\n")
  cat("  - Invariance_Ratio_IR: Ratio of observed versus theoretical Poisson baseline noise per column.\n")
  cat("  - Physical_Deviation_Sp: Log-scaled variance distance score.\n")
  cat("==========================================================\n")
  
  message(sprintf("[SUCCESS] Forensic stability metrics saved to: %s", log_filename))
  return(invisible(stability_report))
}

# Run column-wise generalized physical stability check on raw data
  run_itagaki_component_stability(Dataset)
